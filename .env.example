# =========================================================
# Resep in aja — Multi-Provider Environment Variables
# =========================================================
# Copy file ini menjadi .env (atau set manual di shell kamu).
# Isi minimal SALAH SATU provider yang kamu punya API key-nya.
# Semakin banyak key yang diisi = semakin banyak fallback.
#
# Cara pakai (Mac/Linux):
#   cp .env.example .env
#   # edit .env, isi API key
#   set -a; source .env; set +a
#   python3 server.py
#
# Atau set manual per command:
#   GEMINI_API_KEY="AIza..." python3 server.py
# =========================================================

# --- Provider utama (default: auto = pakai yang pertama tersedia) ---
# Pilihan: auto, openai, anthropic, gemini, xai, groq, openrouter, bigmodel, siliconflow
PROVIDER=auto

# --- OpenAI (GPT-4o / GPT-4o-mini) ---
# Dapatkan: https://platform.openai.com/api-keys (berbayar, ~$0.15/1K gambar)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude (claude-3-5-sonnet / claude-3-haiku) ---
# Dapatkan: https://console.anthropic.com (ada $5 free credit)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Google Gemini (gemini-1.5-flash / gemini-2.0-flash-exp) ---
# Dapatkan: https://aistudio.google.com/apikey (GRATIS, ada quota harian)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- xAI Grok (grok-4 vision) ---
# Dapatkan: https://console.x.ai (berbayar)
# XAI_API_KEY=
# XAI_MODEL=grok-4

# --- Groq (llama-3.2-90b-vision-preview) ---
# Dapatkan: https://console.groq.com (GRATIS, sangat cepat)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.2-90b-vision-preview

# --- OpenRouter (aggregator: Gemini, Claude, GPT, dll dengan 1 key) ---
# Dapatkan: https://openrouter.ai/keys (ada banyak model free)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# --- BigModel / Z.ai (GLM-4V) ---
# Dapatkan: https://open.bigmodel.cn (GRATIS, quota besar)
# BIGMODEL_API_KEY=
# BIGMODEL_MODEL=glm-4v-flash

# --- SiliconFlow (akses DeepSeek-VL2 + Qwen2-VL + InternVL) ---
# Dapatkan: https://siliconflow.cn (GRATIS, free tier ~14M tokens)
# Default model: DeepSeek-VL2 (vision-capable model dari DeepSeek)
# Model alternatif: Qwen/Qwen2-VL-72B-Instruct, OpenGVLab/InternVL2-Llama3-76B
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=deepseek-ai/deepseek-vl2

# --- Port server (default: 8787) ---
PORT=8787

# =========================================================
# Keamanan & Deployment (lihat README "Production Caution")
# =========================================================
# Fallback antar provider: NONAKTIF secara default (privacy-first). Foto hanya
# dikirim ke provider utama, kecuali pengguna meng-opt-in lewat field
# `allowFallback` pada request scan. Set true untuk mengaktifkan global.
# ALLOW_CROSS_PROVIDER_FALLBACK=false

# Origin yang diizinkan untuk deployment publik (CSV). Kosong = same-origin
# (tidak ada header CORS yang dikirim).
# ALLOWED_ORIGINS=https://app.example.com

# Public deployment: mengaktifkan validasi Host/Origin yang lebih ketat.
# Biarkan false untuk mode lokal (bind 127.0.0.1).
# PUBLIC_DEPLOYMENT=false

# Rate limit scan per IP.
# SCAN_RATE_LIMIT_REQUESTS=5
# SCAN_RATE_LIMIT_WINDOW_SECONDS=60

# Kapasitas scan AI bersamaan (semaphore global).
# MAX_CONCURRENT_SCANS=2

# Deadline total scan (detik), selain timeout per provider (25 dtk).
# SCAN_DEADLINE_SECONDS=120

# =========================================================
# Recipe Discovery (Supabase + TheMealDB)
# =========================================================
# Tanpa Supabase, discovery tetap jalan memakai seed data lokal
# (seed_data.py) dan TheMealDB (tanpa API key). Supabase opsional —
# aktifkan untuk katalog resep komunitas dengan RLS.

# --- Supabase (opsional) ---
# Dapatkan: https://supabase.com/dashboard > project > Settings > API
# Gunakan HANYA "anon" key di sini (bukan service_role key). RLS di
# supabase_schema.sql memastikan anon key hanya bisa baca resep publik.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOi...
# SUPABASE_PUBLISHABLE_KEY=  # alias untuk SUPABASE_ANON_KEY (isi salah satu)

# --- TheMealDB (opsional, bisa tanpa key) ---
# Endpoint publik gratis. Key opsional untuk quota lebih tinggi.
# Dapatkan: https://www.themealdb.com/api.php
# THEMEALDB_API_KEY=1

# --- USDA FoodData Central (opsional, hanya estimasi nutrisi) ---
# Bukan sumber resep. Hasil nutrisi wajib diberi label "estimasi".
# Dapatkan: https://fdc.nal.usda.gov/api-guide
# USDA_API_KEY=
# ENABLE_NUTRITION_LOOKUP=false

# --- Discovery behavior ---
# ENABLE_EXTERNAL_RECIPES=false -> hanya pakai seed lokal (offline, tanpa network)
# ENABLE_EXTERNAL_RECIPES=true  -> aktifkan TheMealDB + Supabase
ENABLE_EXTERNAL_RECIPES=true
# Skor kecocokan minimum agar resep ditampilkan (0.0 - 1.0)
RECIPE_MATCH_MIN_SCORE=0.45
EXTERNAL_RECIPE_TIMEOUT_SECONDS=8
